# ============================================
# AI 跨境通 - 环境变量配置
# ============================================
# 复制本文件为 .env，然后填入实际值：
#   cp .env.example .env
#
# ⚠️ 不要把 .env 提交到 Git！


# ============================================
# 数据库 (必填)
# ============================================
# 本地开发：使用 SQLite 文件数据库（开箱即用）
DATABASE_URL="file:./prisma/dev.db"

# 生产环境：使用 Turso (libSQL)
# 注册 https://turso.tech 免费创建数据库
# DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"


# ============================================
# 认证 (必填)
# ============================================
# 用以下命令生成一个 32 字节的随机密钥：
#   openssl rand -base64 32
# Windows PowerShell 可用：
#   [Convert]::ToBase64String([byte[]](1..32 | ForEach-Object {Get-Random -Max 256}))
AUTH_SECRET="your-secret-key-here-please-generate-a-random-one"

# 应用域名（注意：本地开发用 http://localhost:3000，生产用实际域名）
AUTH_URL="http://localhost:3000"


# ============================================
# AI 服务 (推荐至少配置一个)
# ============================================
# DeepSeek API Key（推荐：便宜、中文友好）
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# OpenAI API Key（用于图片生成 / GPT-4 等）
# 申请：https://platform.openai.com/api-keys
OPENAI_API_KEY=""


# ============================================
# 可选配置
# ============================================
# 代理（国内访问 OpenAI / Vercel 等海外服务时需要）
# HTTPS_PROXY="http://127.0.0.1:7897"
# HTTP_PROXY="http://127.0.0.1:7897"
