generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String           @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  apiKey         String?
  apiKeyProvider String           @default("deepseek")
  imageApiKey    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  accounts       Account[]
  projects       ProductProject[]
  sessions       Session[]
}

model ProductProject {
  id                    String             @id @default(cuid())
  userId                String
  productName           String
  category              String?
  features              String?
  sellingPoints         String?
  keywords              String?
  useScenario           String?
  targetAudience        String?
  priceRange            String?
  brandTone             String?
  platform              String
  language              String

  // Basic product info
  brandName             String?
  material              String?
  specifications        String?
  targetCountry         String?

  // User scenario info
  painPoints            String?
  competitiveAdvantages String?
  festivalScenario      String?

  // Brand & style info
  copyStyle             String?
  bannedWords           String?
  isPromotional         Boolean            @default(false)
  isBrandFocused        Boolean            @default(false)

  // Generation config
  visualStyle           String             @default("minimal")
  generationIntensity   String             @default("balanced")

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  records               GenerationRecord[]
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, platform])
}

model GenerationRecord {
  id          String         @id @default(cuid())
  projectId   String
  contentType String
  content     String?
  imageUrl    String?
  prompt      String?
  favorited   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  project     ProductProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, contentType])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([favorited])
}
